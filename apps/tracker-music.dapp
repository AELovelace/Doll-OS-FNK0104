# @dapp-format 1
# @id tracker-music
# @name Tracker Music
# @version 1.0.1
# @boards fnk0104
# @runtime >=1.4.2 <2.0.0
# @echo off
# @summary A saved sixteen-step sequencer for the three-channel synth
# /apps/tracker-music.dapp
# Arrows move, space toggles a step, 1-6 set the selected note tone, +/- changes
# tempo, Enter plays one loop, H/? helps, S/L save/load, C clears, Escape exits.

CANVAS 80 26
DIM p1 16
DIM p2 16
DIM p3 16
DIM t1 16
DIM t2 16
DIM t3 16
DIM f1 6
DIM f2 6
DIM f3 6
SET f1[0] 110
SET f1[1] 131
SET f1[2] 147
SET f1[3] 165
SET f1[4] 196
SET f1[5] 220
SET f2[0] 220
SET f2[1] 262
SET f2[2] 294
SET f2[3] 330
SET f2[4] 392
SET f2[5] 440
SET f3[0] 880
SET f3[1] 1200
SET f3[2] 1800
SET f3[3] 2600
SET f3[4] 4000
SET f3[5] 6500
SET channel 1
SET step 0
SET bpm 120
SET tone1 0
SET tone2 2
SET tone3 3
GOSUB inittones
GOSUB load
GOSUB draw

:loop
KEY k
IF $k = 0 GOTO wait
IF $k = $kesc GOTO leave
IF $k = $kleft GOTO left
IF $k = $kright GOTO right
IF $k = $kup GOTO up
IF $k = $kdown GOTO down
IF $k = $kspace GOTO toggle
IF $k = $kenter GOTO play
IF $k = 43 GOTO faster
IF $k = 45 GOTO slower
IF $k = 115 GOTO savekey
IF $k = 83 GOTO savekey
IF $k = 108 GOTO loadkey
IF $k = 76 GOTO loadkey
IF $k = 99 GOTO clearkey
IF $k = 67 GOTO clearkey
IF $k = 104 GOTO helpkey
IF $k = 72 GOTO helpkey
IF $k = 63 GOTO helpkey
IF $k < 49 GOTO wait
IF $k > 54 GOTO wait
EXPR tone $k - 49
IF $channel = 1 GOTO setnote1
IF $channel = 2 GOTO setnote2
SET tone3 $tone
SET t3[$step] $tone
SET p3[$step] 1
GOTO redraw
:setnote1
SET tone1 $tone
SET t1[$step] $tone
SET p1[$step] 1
GOTO redraw
:setnote2
SET tone2 $tone
SET t2[$step] $tone
SET p2[$step] 1
GOTO redraw

:left
SUB step 1
IF $step >= 0 GOTO redraw
SET step 15
GOTO redraw
:right
ADD step 1
IF $step <= 15 GOTO redraw
SET step 0
GOTO redraw
:up
SUB channel 1
IF $channel >= 1 GOTO redraw
SET channel 3
GOTO redraw
:down
ADD channel 1
IF $channel <= 3 GOTO redraw
SET channel 1
GOTO redraw

:toggle
IF $channel = 1 GOTO tog1
IF $channel = 2 GOTO tog2
EXPR p3[$step] 1 - $p3[$step]
IF $p3[$step] = 0 GOTO redraw
SET t3[$step] $tone3
GOTO redraw
:tog1
EXPR p1[$step] 1 - $p1[$step]
IF $p1[$step] = 0 GOTO redraw
SET t1[$step] $tone1
GOTO redraw
:tog2
EXPR p2[$step] 1 - $p2[$step]
IF $p2[$step] = 0 GOTO redraw
SET t2[$step] $tone2
GOTO redraw

:faster
ADD bpm 10
IF $bpm <= 300 GOTO redraw
SET bpm 300
GOTO redraw
:slower
SUB bpm 10
IF $bpm >= 30 GOTO redraw
SET bpm 30
GOTO redraw

:play
EXPR delayms 15000 / $bpm
SET playstep 0
:playloop
WAVESTOP
IF $p1[$playstep] = 0 GOTO pl2
SET playtone $t1[$playstep]
WAVE 1 square $f1[$playtone] 22
:pl2
IF $p2[$playstep] = 0 GOTO pl3
SET playtone $t2[$playstep]
WAVE 2 triangle $f2[$playtone] 18
:pl3
IF $p3[$playstep] = 0 GOTO plwait
SET playtone $t3[$playstep]
WAVE 3 noise $f3[$playtone] 12
:plwait
SET step $playstep
GOSUB draw
WAIT $delayms
KEY k
IF $k = $kesc GOTO playdone
ADD playstep 1
IF $playstep < 16 GOTO playloop
:playdone
WAVESTOP
GOTO redraw

:savekey
GOSUB save
GOTO redraw
:loadkey
GOSUB load
GOTO redraw
:clearkey
SET i 0
:clearloop
IF $i >= 16 GOTO redraw
SET p1[$i] 0
SET p2[$i] 0
SET p3[$i] 0
SET t1[$i] $tone1
SET t2[$i] $tone2
SET t3[$i] $tone3
ADD i 1
GOTO clearloop

:helpkey
GOSUB help
GOTO redraw

:redraw
GOSUB draw
:wait
WAIT 16
GOTO loop

:draw
CLS
IF $channel = 1 GOTO cur1
IF $channel = 2 GOTO cur2
SET curtone $t3[$step]
GOTO curdone
:cur1
SET curtone $t1[$step]
GOTO curdone
:cur2
SET curtone $t2[$step]
:curdone
EXPR curmark $curtone + 1
COLOR pink
PUT 0 0 "TRACKER MUSIC"
COLOR white
PUT 16 0 "BPM $bpm   voice $channel   selected tone $curmark"
COLOR cyan
PUT 0 3 "step  1 2 3 4 5 6 7 8 9 A B C D E F G"
SET i 0
:drawloop
IF $i >= 16 GOTO drawcursor
EXPR x 6 + $i * 2
IF $p1[$i] = 0 GOTO d1off
COLOR pink
EXPR mark $t1[$i] + 1
PUT $x 6 "$mark"
GOTO d2
:d1off
COLOR white
PUT $x 6 "."
:d2
IF $p2[$i] = 0 GOTO d2off
COLOR cyan
EXPR mark $t2[$i] + 1
PUT $x 9 "$mark"
GOTO d3
:d2off
COLOR white
PUT $x 9 "."
:d3
IF $p3[$i] = 0 GOTO d3off
COLOR yellow
EXPR mark $t3[$i] + 1
PUT $x 12 "$mark"
GOTO dn
:d3off
COLOR white
PUT $x 12 "."
:dn
ADD i 1
GOTO drawloop
:drawcursor
COLOR white
PUT 0 6 "CH1 square"
PUT 0 9 "CH2 tri"
PUT 0 12 "CH3 noise"
EXPR x 6 + $step * 2
EXPR y 3 + $channel * 3
COLOR green
PUT $x $y "@"
COLOR yellow
PUT 0 22 "arrows move  space toggle  enter play  +/- tempo"
PUT 0 24 "1-6 note tone  H help  S save  L load  C clear  esc quit"
FLIP
RETURN

:help
WAVESTOP
CLS
COLOR pink
PUT 0 0 "TRACKER MUSIC HELP"
COLOR white
PUT 0 3 "arrows     move between channels and steps"
PUT 0 5 "space      toggle selected note on/off"
PUT 0 7 "1-6        set selected note tone and turn it on"
PUT 0 9 "enter      play one 16-step loop"
PUT 0 11 "+ / -      change tempo"
PUT 0 13 "S / L      save or load /apps/tracker-music.dat"
PUT 0 15 "C          clear the pattern"
PUT 0 17 "esc        quit tracker"
COLOR cyan
PUT 0 21 "Active notes show their tone number."
PUT 0 23 "Press any key to return."
FLIP
:helpwait
WAIT 16
KEY hk
IF $hk = 0 GOTO helpwait
RETURN

:inittones
SET i 0
:initloop
IF $i >= 16 GOTO initdone
SET t1[$i] $tone1
SET t2[$i] $tone2
SET t3[$i] $tone3
ADD i 1
GOTO initloop
:initdone
RETURN

:save
FOPEN "/apps/tracker-music.dat" write
IF $fok = 0 GOTO svdone
FWRITE "$bpm"
FWRITE "$tone1 $tone2 $tone3"
SET row 1
:svrow
IF $row > 3 GOTO svtones
SETSTR line ""
SET i 0
:svbits
IF $i >= 16 GOTO svwrite
IF $row = 1 GOTO sv1
IF $row = 2 GOTO sv2
SET bit $p3[$i]
GOTO svadd
:sv1
SET bit $p1[$i]
GOTO svadd
:sv2
SET bit $p2[$i]
:svadd
IF $bit = 0 GOTO svzero
APPEND line "1"
GOTO svn
:svzero
APPEND line "0"
:svn
ADD i 1
GOTO svbits
:svwrite
FWRITE "$line"
ADD row 1
GOTO svrow
:svtones
SET row 1
:svtrow
IF $row > 3 GOTO svdone
SETSTR line ""
SET i 0
:svtbits
IF $i >= 16 GOTO svtwrite
IF $row = 1 GOTO svt1
IF $row = 2 GOTO svt2
SET val $t3[$i]
GOTO svtadd
:svt1
SET val $t1[$i]
GOTO svtadd
:svt2
SET val $t2[$i]
:svtadd
ADD val 48
CHR one $val
APPEND line $one
ADD i 1
GOTO svtbits
:svtwrite
FWRITE "$line"
ADD row 1
GOTO svtrow
:svdone
FCLOSE
RETURN

:load
FEXISTS have "/apps/tracker-music.dat"
IF $have = 0 GOTO lddone
FOPEN "/apps/tracker-music.dat" read
IF $fok = 0 GOTO lddone
FREAD text
GOSUB str2num
IF $got = 1 GOTO ldbpm
GOTO ldtone
:ldbpm
SET bpm $num
:ldtone
FREAD line
SET pos 0
GOSUB readnum
SET tone1 $num
GOSUB readnum
SET tone2 $num
GOSUB readnum
SET tone3 $num
GOSUB inittones
SET row 1
:ldrow
IF $row > 3 GOTO ldtones
FREAD line
IF $feof = 1 GOTO lddone
SET i 0
:ldbits
IF $i >= 16 GOTO ldnext
CHARAT bit $line $i
IF $bit = 49 GOTO ldone
SET bit 0
GOTO ldset
:ldone
SET bit 1
:ldset
IF $row = 1 GOTO ld1
IF $row = 2 GOTO ld2
SET p3[$i] $bit
GOTO ldn
:ld1
SET p1[$i] $bit
GOTO ldn
:ld2
SET p2[$i] $bit
:ldn
ADD i 1
GOTO ldbits
:ldnext
ADD row 1
GOTO ldrow
:ldtones
SET row 1
:ldtrow
IF $row > 3 GOTO lddone
FREAD line
IF $feof = 1 GOTO lddone
SET i 0
:ldtbits
IF $i >= 16 GOTO ldtnext
CHARAT val $line $i
IF $val < 48 GOTO ldtn
IF $val > 53 GOTO ldtn
SUB val 48
IF $row = 1 GOTO ldt1
IF $row = 2 GOTO ldt2
SET t3[$i] $val
GOTO ldtn
:ldt1
SET t1[$i] $val
GOTO ldtn
:ldt2
SET t2[$i] $val
:ldtn
ADD i 1
GOTO ldtbits
:ldtnext
ADD row 1
GOTO ldtrow
:lddone
FCLOSE
RETURN

# reads the next integer from line at pos
:readnum
SETSTR text ""
:rnspace
CHARAT ch $line $pos
IF $ch <> 32 GOTO rndigits
ADD pos 1
GOTO rnspace
:rndigits
CHARAT ch $line $pos
IF $ch < 48 GOTO rnparse
IF $ch > 57 GOTO rnparse
CHR one $ch
APPEND text $one
ADD pos 1
GOTO rndigits
:rnparse
GOSUB str2num
RETURN

:str2num
SET num 0
SET got 0
SET j 0
LEN n $text
IF $n = 0 GOTO sn_done
SET got 1
:sn_loop
IF $j >= $n GOTO sn_done
CHARAT digit $text $j
IF $digit < 48 GOTO sn_bad
IF $digit > 57 GOTO sn_bad
SUB digit 48
MUL num 10
ADD num $digit
ADD j 1
GOTO sn_loop
:sn_bad
SET got 0
:sn_done
RETURN

:leave
WAVESTOP
ENDCANVAS
PRINT "tracker-music: done"
EXIT
